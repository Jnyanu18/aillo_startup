# --- Mail notification (sent directly from the consultation form's server function) ---
# No database, no third-party email service — just the info@accelerationlogics.com
# mailbox's own SMTP (GoDaddy Workspace Email, per the domain's MX records).
MAIL_USER="info@accelerationlogics.com"
# The regular mailbox password for info@accelerationlogics.com.
